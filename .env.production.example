# Production template. Copy the values into the server's .env; never commit real secrets.
# See docs/production-security.md for the reasoning and the verification commands.

APP_NAME="心の庵 ZEN REFLECTIONS"
APP_ENV=production
# Keep the existing production key. Changing it invalidates sessions, encrypted share tokens and other encrypted data.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CA_BUNDLE=
STRIPE_PRICE_LITE=
STRIPE_PRICE_LITE_YEARLY=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_YEARLY=
